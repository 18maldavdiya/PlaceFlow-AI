# PlaceFlow AI — server container image
# Build context is the repository root (see docker-compose.yml), so every
# path below is relative to PlaceFlow-AI/, not to docker/ or server/.
# Multi-stage: shared base -> development (nodemon, hot reload) -> production (slim runtime)

# ---------- base ----------
FROM node:20-alpine AS base
WORKDIR /app
COPY server/package*.json ./
RUN npm ci

# ---------- development ----------
FROM base AS development
ENV NODE_ENV=development
COPY server/. .
EXPOSE 5000
CMD ["npm", "run", "dev"]

# ---------- build (production deps only) ----------
FROM node:20-alpine AS build
WORKDIR /app
COPY server/package*.json ./
RUN npm ci --omit=dev
COPY server/. .

# ---------- production ----------
FROM node:20-alpine AS production
ENV NODE_ENV=production
WORKDIR /app
RUN addgroup -S placeflow && adduser -S placeflow -G placeflow
COPY --from=build /app ./
USER placeflow
EXPOSE 5000
CMD ["node", "server.js"]
