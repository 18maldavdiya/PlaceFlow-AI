# PlaceFlow AI — client container image
# Build context is the repository root (see docker-compose.yml), so every
# path below is relative to PlaceFlow-AI/, not to docker/ or client/.
# Multi-stage: shared base -> development (Vite dev server, hot reload) -> production (static Nginx)

# ---------- base ----------
FROM node:20-alpine AS base
WORKDIR /app
COPY client/package*.json ./
RUN npm ci

# ---------- development ----------
FROM base AS development
ENV NODE_ENV=development
COPY client/. .
EXPOSE 5173
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]

# ---------- build ----------
FROM base AS build
COPY client/. .
RUN npm run build

# ---------- production ----------
FROM nginx:1.27-alpine AS production
COPY --from=build /app/dist /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
