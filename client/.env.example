# PlaceFlow AI — client environment variables
# Copy this file to .env (and .env.production / .env.staging as needed) and fill in real values.
# Every variable consumed in the browser MUST be prefixed with VITE_ — Vite only
# exposes prefixed variables to client code; anything else stays server-only by design.

# Base URL the Axios instance (src/services/api.js) targets for all API calls.
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Used only by vite.config.js dev-server proxy — not read by application code.
VITE_API_PROXY_TARGET=http://localhost:5000

# Socket.io server URL (src/lib/socket.js)
VITE_SOCKET_URL=http://localhost:5000

# Cloudinary unsigned upload preset for direct-from-browser uploads, if used later.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Human-facing app metadata
VITE_APP_NAME=PlaceFlow AI
VITE_APP_ENV=development
